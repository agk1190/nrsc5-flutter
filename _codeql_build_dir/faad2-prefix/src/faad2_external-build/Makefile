# target to preprocess a source file
libfaad/syntax.c.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/faad.dir/build.make CMakeFiles/faad.dir/libfaad/syntax.c.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles/faad_drm.dir/build.make CMakeFiles/faad_drm.dir/libfaad/syntax.c.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles/faad_hdc.dir/build.make CMakeFiles/faad_hdc.dir/libfaad/syntax.c.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles/faad_fixed.dir/build.make CMakeFiles/faad_fixed.dir/libfaad/syntax.c.i
	$(MAKE) $(MAKESILENT) -f CMakeFiles/faad_drm_fixed.dir/build.make CMakeFiles/faad_drm_fixed.dir/libfaad/syntax.c.i
.PHONY : libfaad/syntax.c.i

